{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lightua/heartbeat.v2",
  "title": "Стан останнього циклу парсера (колекція heartbeat, один документ)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finished_at", "status", "channels_ok", "channels_failed"],
  "properties": {
    "schema_version": { "const": 2 },
    "finished_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "status": { "enum": ["success", "partial", "error"] },
    "channels_ok": { "type": "integer", "minimum": 0 },
    "channels_failed": { "type": "integer", "minimum": 0 }
  }
}
