{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lightua/parse_state.v2",
  "title": "Де парсер зупинився в каналі (колекція parse_state)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "channel_id", "last_message_id", "updated_at"],
  "properties": {
    "schema_version": { "const": 2 },
    "channel_id": { "type": "integer", "minimum": 1 },
    "last_message_id": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
