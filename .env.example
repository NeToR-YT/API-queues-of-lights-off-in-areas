# Скопіюйте у .env і заповніть. .env у git НЕ потрапляє (див. .gitignore).
# Несекретні налаштування (канали, інтервали) — у backend-js/config.json,
# шаблон: backend-js/config.example.json

# ── Telegram (my.telegram.org → API development tools) ──
TG_API_ID=
TG_API_HASH=

# Сесія зберігається у backend-js/secrets/session.txt при першому вході.
# Через змінну задавати не обов'язково — лишіть порожнім.
TG_SESSION_STRING=

# ── Mongo ───────────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=queues_of_lights

# ── Публічна адреса ─────────────────────────────────────
# Домен, який указує на IP сервера (напр. svitloua.duckdns.org).
# Caddy отримає для нього сертифікат Let's Encrypt. Порожньо — localhost.
DOMAIN=

# ── HTTP ────────────────────────────────────────────────
PORT=5001
