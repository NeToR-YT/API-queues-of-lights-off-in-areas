# Скопіюйте у .env і заповніть. Сам .env у git не потрапляє (див. .gitignore).
# Несекретні налаштування (канали, інтервали) лежать у backend-js/config.json,
# шаблон: backend-js/config.example.json

# ── Telegram (my.telegram.org → API development tools) ──
TG_API_ID=
TG_API_HASH=

# Сесія зберігається у backend-js/secrets/session.txt під час першого входу,
# тож цю змінну можна лишити порожньою.
TG_SESSION_STRING=

# ── Mongo ───────────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=queues_of_lights

# ── Публічна адреса ─────────────────────────────────────
# Домен, що вказує на IP сервера, наприклад svitloua.duckdns.org.
# Caddy отримає для нього сертифікат Let's Encrypt. Якщо порожньо, працює localhost.
DOMAIN=

# ── HTTP ────────────────────────────────────────────────
PORT=5001
