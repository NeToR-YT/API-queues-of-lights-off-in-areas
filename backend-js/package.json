{
  "name": "backend-js",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "start": "tsx src/app.ts",
    "build": "tsc",
    "start:prod": "node dist/app.js",
    "fetch": "tsx src/fetcher.ts",
