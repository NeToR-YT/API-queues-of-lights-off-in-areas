# Публічна точка входу: HTTPS із сертифікатом Let's Encrypt, який Caddy отримує
# й оновлює сам. Домен задає змінна DOMAIN у .env (наприклад, svitloua.duckdns.org).
# Без DOMAIN працює localhost із самопідписаним сертифікатом для локальних перевірок.
#
# Правила доступу до API (403 на /api/update, rate limit) тримає nginx за Caddy.

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy proxy:80
}

# Dev-середовище (deploy/compose.dev.yml). Поки dev-стек не запущений, тут буде 502.
{$DEV_DOMAIN:dev.localhost} {
	encode zstd gzip

	header {
		-Server
	}

	reverse_proxy light-ua-dev-proxy:80
}
