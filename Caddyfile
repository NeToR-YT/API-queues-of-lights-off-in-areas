# Публічна точка входу: HTTPS із сертифікатом Let's Encrypt, який Caddy отримує
# й оновлює сам. Домен — змінна DOMAIN у .env (напр. svitloua.duckdns.org).
# Без DOMAIN — localhost із локальним самопідписаним сертифікатом для перевірок.
#
# Усю логіку (статика, /api, 403 на /api/update, rate limit) тримає nginx за Caddy.

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy frontend:80
}
